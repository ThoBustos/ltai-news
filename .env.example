APP_NAME="LTAI News"
LOG_LEVEL=INFO
SUPABASE_PROJECT_URL=
SUPABASE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_JSON_PATH=
GOOGLE_API_KEY=
OPIK_API_KEY=
OPIK_PROJECT_NAME=
OPIK_WORKSPACE=
TRACKED_CHANNELS=@lets-talk-ai,@latentspacepod,@limitless-ft,@Fireship,@stripe,@WeightsBiases,@Deeplearningai,@ycombinator,@mindsetmentorpodcast,@AlexHormozi,@LennysPodcast,@AcquiredFM,@a16z,@twimlai,@aiDotEngineer,@lexfridman,@hubermanlab,@DataIndependent,@daltonplusmichael,@DwarkeshPatel,@pragmaticengineer,@NoPriorsPodcast
CONTENT_LOOKBACK_HOURS=168  # Default lookback for all channels

# Video Duration Configuration
# Hard floor: 3 minutes (enforced in code) - no videos below this will be processed
# Per-channel thresholds (format: channel:minutes,channel:minutes)
# Channels not listed here default to 3 minutes (hard minimum)
CHANNEL_DURATION_THRESHOLDS=@stripe:20,@AlexHormozi:5

# Orchestrator Configuration
PROCESSING_BATCH_SIZE=10
MAX_RETRY_ATTEMPTS=3
PROCESSING_TIMEOUT_MINUTES=30
DEFAULT_PIPELINE_DATE=2025-12-19

# VIP Channel Configuration (for extended lookback - separate from duration)
BYPASS_LOOKBACK_CHANNELS=  # Channels that need deeper historical scan
EXTENDED_LOOKBACK_HOURS=720  # How far back to scan VIP channels (default: 30 days)

# Transcript.io Configuration
TRANSCRIPT_IO_API_KEY="Basic <your_key_here>"
TRANSCRIPT_IO_BASE_URL="https://www.youtube-transcript.io/api"
TRANSCRIPT_LANGUAGE_CODE="en"

# Video Analysis Configuration
ANALYSIS_MODEL_NAME="gemini-3.0-flash"
ANALYSIS_TIMEOUT_SECONDS=500

# Digest schema version: v3 (minimalist, default) or v2 (layered with deep analysis)
DIGEST_SCHEMA_VERSION=v3

# X/Twitter OAuth 2.0 Configuration (for Phase 5: Auto-posting)
# Generate tokens using: python scripts/generate_twitter_oauth2_tokens_auto.py
TWITTER_OAUTH2_CLIENT_ID=your_oauth2_client_id_here
TWITTER_OAUTH2_CLIENT_SECRET=your_oauth2_client_secret_here
TWITTER_OAUTH2_ACCESS_TOKEN=your_oauth2_access_token_here
TWITTER_OAUTH2_REFRESH_TOKEN=your_oauth2_refresh_token_here

# Auto-post threads to X (set to true after testing)
AUTO_POST_TO_X=false

ID DE SECRETO CLIENT: 