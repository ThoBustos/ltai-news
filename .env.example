APP_NAME="LTAI News"
LOG_LEVEL=INFO
SUPABASE_PROJECT_URL=
SUPABASE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_JSON_PATH=
TRACKED_CHANNELS=@lets-talk-ai,@latentspacepod,@limitless-ft,@Fireship,@stripe,@WeightsBiases,@Deeplearningai,@ycombinator,@mindsetmentorpodcast,@AlexHormozi
CONTENT_LOOKBACK_HOURS=168 # 168: Look back 1 week

# Orchestrator Configuration
PROCESSING_BATCH_SIZE=10
MAX_RETRY_ATTEMPTS=3
PROCESSING_TIMEOUT_MINUTES=30
MIN_VIDEO_DURATION_MINUTES=20
DEFAULT_PIPELINE_DATE=2025-12-19

# VIP Channel Configuration
# Comma-separated channel names or handles
BYPASS_DURATION_CHANNELS=@Fireship,@ycombinator,@latentspacepod,@mindsetmentorpodcast,@AlexHormozi,@LennysPodcast,@AcquiredFM,@a16z,@twimlai,@aiDotEngineer,@lexfridman,@hubermanlab,@DataIndependent,@daltonplusmichael,@DwarkeshPatel,@pragmaticengineer # List channels (like Fireship) that should skip the 20-minute filter.
BYPASS_LOOKBACK_CHANNELS= # List channels that should get a "Deep Scan
EXTENDED_LOOKBACK_HOURS=720 # Set how far back the VIP scan goes (default 720 hours).

# Transcript.io Configuration
TRANSCRIPT_IO_API_KEY="Basic <your_key_here>"
TRANSCRIPT_IO_BASE_URL="https://www.youtube-transcript.io/api"
TRANSCRIPT_LANGUAGE_CODE="en"
